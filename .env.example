# Copy this file to .env and set paths on your own computer. Do not commit .env.
HEALTH_MODEL_PATH=
INSTRUMENT_MODEL_PATH=
POSE_MODEL_PATH=
SURGICAL_OUTPUT_DIR=outputs
SURGICAL_DEVICE=auto

# Optional SAM3 integration. Leave empty for the base/legacy pipeline.
SAM3_REPO_PATH=
SAM3_MODEL_PATH=
